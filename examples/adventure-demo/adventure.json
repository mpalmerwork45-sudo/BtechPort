  "events": [
    {
      "id": "frontier:end",
      "op": "end"
    },
    {
      "id": "frontier:welcome",
      "op": "say",
      "text": "Welcome to Frontier Depot. The west doorway is a mech broker. The east doorway offers a recruit and a patrol contract. Follow the road east to the proving ground. Space opens your menu. F5 saves and F9 restores this exact project.",
      "next": "frontier:end"
    },
    {
      "id": "frontier:broker",
      "op": "choice",
      "text": "Welcome to Frontier Motors. Every model here comes from this project. What can I do for you?",
      "options": [
        {
          "label": "Browse mechs",
          "next": "frontier:shop"
        },
        {
          "label": "About this depot",
          "next": "frontier:about"
        },
        {
          "label": "Leave",
          "next": "frontier:end"
        }
      ],
      "cancel": "frontier:end"
    },
    {
      "id": "frontier:shop",
      "op": "shop",
      "shop": "frontier:depot",
      "next": "frontier:broker"
    },
    {
      "id": "frontier:about",
      "op": "say",
      "text": "Our catalogue is selected by this building, independently of the full roster. You can buy, sell and assign pilots from the Space menu outside. The depot uses original-game artwork supplied by you.",
      "next": "frontier:broker"
    },
    {
      "id": "frontier:hall",
      "op": "choice",
      "text": "A mechanic needs help with an armed trespasser at the proving ground. A pilot is also seeking work.",
      "options": [
        {
          "label": "Recruit the pilot",
          "next": "frontier:hire-check"
        },
        {
          "label": "Ask about the patrol",
          "next": "frontier:job-check"
        },
        {
          "label": "Leave",
          "next": "frontier:end"
        }
      ],
      "cancel": "frontier:end"
    },
    {
      "id": "frontier:hire-check",
      "op": "if",
      "flag": "frontier:hired",
      "value": 1,
      "then": "frontier:already-hired",
      "else": "frontier:hire"
    },
    {
      "id": "frontier:hire",
      "op": "recruit",
      "person": "frontier:pilot",
      "next": "frontier:hired-flag",
      "failure": "frontier:no-room"
    },
    {
      "id": "frontier:hired-flag",
      "op": "flag",
      "flag": "frontier:hired",
      "value": 1,
      "next": "frontier:hired"
    },
    {
      "id": "frontier:hired",
      "op": "say",
      "text": "Rex joins your party. He can pilot an additional mech. Buy one at the broker, then assign its crew from the Space menu outside.",
      "next": "frontier:hall"
    },
    {
      "id": "frontier:already-hired",
      "op": "say",
      "text": "The pilot has already joined your expedition.",
      "next": "frontier:hall"
    },
    {
      "id": "frontier:no-room",
      "op": "say",
      "text": "There is no room in the party, or that pilot is already with you.",
      "next": "frontier:hall"
    },
    {
      "id": "frontier:job-check",
      "op": "if",
      "flag": "frontier:cleared",
      "value": 1,
      "then": "frontier:thanks",
      "else": "frontier:job"
    },
    {
      "id": "frontier:job",
      "op": "say",
      "text": "Travel east along the road. At the proving ground, approach the patrol marker. Defeat the trespasser and you will receive 2500 C-bills. You can withdraw from this battle using the combat menu.",
      "next": "frontier:hall"
    },
    {
      "id": "frontier:thanks",
      "op": "say",
      "text": "The proving ground is secure. Your payment has already been credited. Thank you.",
      "next": "frontier:end"
    },
    {
      "id": "frontier:to-field",
      "op": "transfer",
      "map": "frontier:field",
      "at": [
        12,
        28
      ],
      "next": "frontier:field-intro",
      "failure": "frontier:blocked"
    },
    {
      "id": "frontier:field-intro",
      "op": "say",
      "text": "The proving ground lies ahead. Approach the marker to your east to begin the patrol. The return gate is just west of you.",
      "next": "frontier:end"
    },
    {
      "id": "frontier:to-town",
      "op": "transfer",
      "map": "frontier:depot-map",
      "at": [
        50,
        28
      ],
      "next": "frontier:end",
      "failure": "frontier:blocked"
    },
    {
      "id": "frontier:blocked",
      "op": "say",
      "text": "Your formation cannot fit at the destination. Reassign crew or reduce your formation and try again.",
      "next": "frontier:end"
    },
    {
      "id": "frontier:patrol-check",
      "op": "if",
      "flag": "frontier:cleared",
      "value": 1,
      "then": "frontier:thanks",
      "else": "frontier:patrol-choice"
    },
    {
      "id": "frontier:patrol-choice",
      "op": "choice",
      "text": "An armed trespasser challenges your patrol. Engage?",
      "options": [
        {
          "label": "Engage",
          "next": "frontier:fight"
        },
        {
          "label": "Leave peacefully",
          "next": "frontier:end"
        }
      ],
      "cancel": "frontier:end"
    },
    {
      "id": "frontier:fight",
      "op": "battle",
      "encounter": "frontier:patrol",
      "win": "frontier:reward",
      "loss": "frontier:defeat",
      "flee": "frontier:withdraw",
      "failure": "frontier:blocked"
    },
    {
      "id": "frontier:reward",
      "op": "reward",
      "credits": 2500,
      "next": "frontier:cleared-flag",
      "failure": "frontier:full-wallet"
    },
    {
      "id": "frontier:cleared-flag",
      "op": "flag",
      "flag": "frontier:cleared",
      "value": 1,
      "next": "frontier:victory"
    },
    {
      "id": "frontier:victory",
      "op": "say",
      "text": "Patrol complete. The depot credits your account with 2500 C-bills. This reward can only be collected once, including after saving and restoring.",
      "next": "frontier:end"
    },
    {
      "id": "frontier:withdraw",
      "op": "say",
      "text": "You withdraw from the proving ground. The contract remains open.",
      "next": "frontier:end"
    },
    {
      "id": "frontier:defeat",
      "op": "say",
      "text": "Your patrol has been defeated. Restore a saved game to try again.",
      "next": "frontier:end"
    },
    {
      "id": "frontier:full-wallet",
      "op": "say",
      "text": "Your account cannot hold the reward. Spend some credits and return.",
      "next": "frontier:end"
    }
  ],
