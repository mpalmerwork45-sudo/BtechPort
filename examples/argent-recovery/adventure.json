      "id": "recovery:collect-west",
      "op": "variable",
      "variable": "recovery:data",
      "action": "add",
      "value": 1,
      "once": 1,
      "next": "recovery:count-data",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:collect-east",
      "op": "variable",
      "variable": "recovery:data",
      "action": "add",
      "value": 1,
      "once": 1,
      "next": "recovery:count-data",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:count-data",
      "op": "check",
      "match": "all",
      "conditions": [
        {
          "kind": "variable",
          "id": "recovery:data",
          "compare": "eq",
          "value": 2
        }
      ],
      "then": "recovery:collected",
      "else": "recovery:one-cache"
    },
    {
      "id": "recovery:collected",
      "op": "objective",
      "objective": "recovery:collect",
      "state": "complete",
      "next": "recovery:two-caches",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:one-cache",
      "op": "say",
      "text": "First cache uploaded. One more remains along the road to the east.",
      "next": "recovery:end"
    },
    {
      "id": "recovery:two-caches",
      "op": "say",
      "text": "Both caches secured. Survey the northern relay, then bring the data to the western pad.",
      "next": "recovery:end"
    },
    {
      "id": "recovery:survey",
      "op": "variable",
      "variable": "recovery:surveyed",
      "action": "set",
      "value": 1,
      "once": 1,
      "next": "recovery:survey-complete",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:survey-complete",
      "op": "objective",
      "objective": "recovery:survey",
      "state": "complete",
      "next": "recovery:survey-message",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:survey-message",
      "op": "say",
      "text": "Relay survey complete. The landing pad can now authenticate both data caches.",
      "next": "recovery:end"
    },
    {
      "id": "recovery:pad-enter",
      "op": "variable",
      "variable": "recovery:visits",
      "action": "add",
      "value": 1,
      "once": 0,
      "next": "recovery:extract-check",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:pad-leave",
      "op": "variable",
      "variable": "recovery:departures",
      "action": "add",
      "value": 1,
      "once": 0,
      "next": "recovery:end",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:extract-check",
      "op": "check",
      "match": "all",
      "conditions": [
        {
          "kind": "variable",
          "id": "recovery:data",
          "compare": "eq",
          "value": 2
        },
        {
          "kind": "variable",
          "id": "recovery:surveyed",
          "compare": "eq",
          "value": 1
        },
        {
          "kind": "objective",
          "id": "recovery:extract",
          "compare": "eq",
          "value": "active"
        },
        {
          "kind": "region",
          "id": "recovery:landing-pad",
          "compare": "eq",
          "value": 1
        }
      ],
      "then": "recovery:lua-check",
      "else": "recovery:not-ready"
    },
    {
      "id": "recovery:not-ready",
      "op": "say",
      "text": "Extraction requires both caches and the northern relay survey. Follow the road east; the relay is above its midpoint.",
      "next": "recovery:end"
    },
    {
      "id": "recovery:lua-check",
      "op": "lua",
      "script": "recovery:verify",
      "routes": [
        "recovery:extract-complete",
        "recovery:error"
      ],
      "failure": "recovery:error"
    },
    {
      "id": "recovery:extract-complete",
      "op": "objective",
      "objective": "recovery:extract",
      "state": "complete",
      "next": "recovery:payment",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:payment",
      "op": "reward",
      "credits": 4000,
      "next": "recovery:success",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:success",
      "op": "finish",
      "text": "The DropShip lifts off with both caches. Argent Recovery completed. Your lance receives 4,000 credits. Press Space to finish."
    },
    {
      "id": "recovery:abandon",
      "op": "objective",
      "objective": "recovery:extract",
      "state": "failed",
      "next": "recovery:abandoned",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:abandoned",
      "op": "finish",
      "text": "You withdraw without the data. The extraction contract has failed. Your surviving lance can seek another employer."
    },
    {
      "id": "recovery:raider-choice",
      "op": "choice",
      "text": "A raider guards the eastern approach. Engage?",
      "options": [
        {
          "label": "Engage",
          "next": "recovery:battle"
        },
        {
          "label": "Leave",
          "next": "recovery:end"
        }
      ],
      "cancel": "recovery:end"
    },
    {
      "id": "recovery:battle",
      "op": "battle",
      "encounter": "recovery:raider",
      "win": "recovery:raider-win",
      "loss": "recovery:abandon",
      "flee": "recovery:raider-retreat",
      "failure": "recovery:error"
    },
    {
      "id": "recovery:raider-win",
      "op": "say",
      "text": "The eastern approach is clear. Recover the data and return to the landing pad.",
      "next": "recovery:end"
    },
    {
      "id": "recovery:raider-retreat",
      "op": "say",
      "text": "Your lance breaks contact. The caches and relay remain available; retreat from this skirmish does not cancel the contract.",
      "next": "recovery:end"
    }
  ],
