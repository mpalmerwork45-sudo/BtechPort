  "events": [
    {
      "id": "beacon:end",
      "op": "end"
    },
    {
      "id": "beacon:welcome",
      "op": "say",
      "text": "Lyran Commonwealth border, 3025. You command Beacon Company: Rowan in a Phoenix Hawk PXH-1, with Mira in a Trebuchet TBT-5N. Pirates have cut Grayhaven's road to its relay. Your employer offers 8,000 C-bills to reopen the road. A second job waits beyond it.",
      "next": "beacon:directions",
      "portrait": "training"
    },
    {
      "id": "beacon:directions",
      "op": "say",
      "text": "Visit the contract office at the eastern garage door, north of the road. The west door exchanges 'Mechs and combat vehicles. Cole, a spare pilot, waits on the road between them. ComStar has an office northeast. Travel east when ready. Space opens inspection, crew, map and saves; F5 saves, F9 restores.",
      "next": "beacon:offer",
      "portrait": "training"
    },
    {
      "id": "beacon:office",
      "op": "lua",
      "script": "beacon:contract",
      "routes": [
        "beacon:offer",
        "beacon:road-report",
        "beacon:reminder",
        "beacon:relay-report",
        "beacon:second-offer"
      ],
      "failure": "beacon:script-error"
    },
    {
      "id": "beacon:offer",
      "op": "choice",
      "text": "Militia captain: Clear the Javelin blocking Quarry Road. Your two 'Mechs should be enough. Payment: 8,000 C-bills.",
      "options": [
        {
          "label": "Accept the contract",
          "next": "beacon:accept"
        },
        {
          "label": "Tactical briefing",
          "next": "beacon:tactics"
        },
        {
          "label": "Not yet",
          "next": "beacon:end"
        }
      ],
      "cancel": "beacon:end",
      "portrait": "training"
    },
    {
      "id": "beacon:accept",
      "op": "flag",
      "flag": "beacon:accepted",
      "value": 1,
      "next": "beacon:brief"
    },
    {
      "id": "beacon:brief",
      "op": "say",
      "text": "Contract accepted. Follow the road east to the checkpoint. Phoenix Hawk: fast jump-capable skirmisher with a large laser. Trebuchet: twin LRM-15 support; keep it behind the Hawk. Enhanced rules penalize LRMs inside minimum range. Return here after the fight.",
      "next": "beacon:end",
      "portrait": "training"
    },
    {
      "id": "beacon:tactics",
      "op": "say",
      "text": "Walk, run and jump are available in manual combat. Use trees for cover. The Hawk's jump jets can cross obstacles, but jumping and lasers add heat. Keep the Trebuchet back; its medium lasers are the fallback at close range. Computer combat is available. You can pause it with Space.",
      "next": "beacon:offer",
      "portrait": "training"
    },
    {
      "id": "beacon:reminder",
      "op": "say",
      "text": "The contract is open. Head east along Quarry Road, clear the pirate Javelin and report back here. You may withdraw and try again; damage and ammunition use persist.",
      "next": "beacon:end",
      "portrait": "training"
    },
    {
      "id": "beacon:broker",
      "op": "choice",
      "text": "The broker wipes grease from a sales slate. Nine 'Mech models and ten combat vehicles: tanks, hovercraft, scouts and missile carriers. Stock is grouped by weight. Cash on delivery.",
      "options": [
        {
          "label": "Buy or sell units",
          "next": "beacon:shop"
        },
        {
          "label": "Ask about crew",
          "next": "beacon:crew-info"
        },
        {
          "label": "Leave",
          "next": "beacon:end"
        }
      ],
      "cancel": "beacon:end",
      "portrait": "broker"
    },
    {
      "id": "beacon:shop",
      "op": "shop",
      "shop": "beacon:exchange",
      "next": "beacon:broker"
    },
    {
      "id": "beacon:crew-info",
      "op": "say",
      "text": "Four bays total, shared by 'Mechs and vehicles. Every active unit needs a pilot or driver: use Allocate People from the Space menu outside. Cole is looking for work near the road. Sell a unit here to free a bay. Keep some C-bills in reserve.",
      "next": "beacon:broker",
      "portrait": "broker"
    },
    {
      "id": "beacon:hire-check",
      "op": "if",
      "flag": "beacon:hired",
      "value": 1,
      "then": "beacon:already-hired",
      "else": "beacon:hire-offer"
    },
    {
      "id": "beacon:hire-offer",
      "op": "choice",
      "text": "Cole taps his neurohelmet. I'm a pilot, not a passenger. Got a spare cockpit? I'll sign on for this contract.",
      "options": [
        {
          "label": "Recruit Cole",
          "next": "beacon:hire"
        },
        {
          "label": "Later",
          "next": "beacon:end"
        }
      ],
      "cancel": "beacon:end",
      "portrait": "training"
    },
    {
      "id": "beacon:hire",
      "op": "recruit",
      "person": "beacon:cole",
      "next": "beacon:hired",
      "failure": "beacon:full"
    },
    {
      "id": "beacon:hired",
      "op": "flag",
      "flag": "beacon:hired",
      "value": 1,
      "next": "beacon:hire-info"
    },
    {
      "id": "beacon:hire-info",
      "op": "say",
      "text": "Cole joins Beacon Company. Buy him a 'Mech or vehicle at the exchange and assign him through the Space menu. Until then, put him in a passenger seat or keep him out of trouble on foot.",
      "next": "beacon:end",
      "portrait": "training"
    },
    {
      "id": "beacon:already-hired",
      "op": "say",
      "text": "Cole is already part of Beacon Company.",
      "next": "beacon:end",
      "portrait": "training"
    },
    {
      "id": "beacon:full",
      "op": "say",
      "text": "There is no free place in your company.",
      "next": "beacon:end",
      "portrait": "training"
    },
    {
      "id": "beacon:news",
      "op": "say",
      "text": "The ComStar liaison lowers her voice. This is a local relay, not an HPG. The pirates want the traffic records and the militia's landing schedule. Reopen the road first. If you recover the station, I can relay your report to our employer.",
      "next": "beacon:end",
      "portrait": "comstar"
    },
    {
      "id": "beacon:road-gate",
      "op": "if",
      "flag": "beacon:accepted",
      "value": 1,
      "then": "beacon:to-road",
      "else": "beacon:need-contract"
    },
    {
      "id": "beacon:need-contract",
      "op": "say",
      "text": "Visit the contract office before deploying. Your employer must authorize this job.",
      "next": "beacon:end",
      "portrait": "training"
    },
    {
      "id": "beacon:to-road",
      "op": "transfer",
