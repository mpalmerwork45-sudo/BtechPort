  "events": [
    {
      "id": "beacon:end",
      "op": "end"
    },
    {
      "id": "beacon:welcome",
      "op": "say",
      "portrait": "training",
      "text": "Grayhaven's last relay has gone silent. Without it the valley will lose contact with the rescue fleet. Visit the Relay Office, recruit Mira, and take your walker east to the beacon.",
      "next": "beacon:end"
    },
    {
      "id": "beacon:shop",
      "op": "shop",
      "shop": "beacon:depot",
      "next": "beacon:end"
    },
    {
      "id": "beacon:office",
      "op": "lua",
      "script": "beacon:contract",
      "routes": [
        "beacon:offer",
        "beacon:reward",
        "beacon:reminder",
        "beacon:completed"
      ],
      "failure": "beacon:script-error"
    },
    {
      "id": "beacon:offer",
      "op": "choice",
      "portrait": "training",
      "text": "Mira folds a survey map. The relay guardian has malfunctioned. I can help. Will you take me along?",
      "options": [
        {
          "label": "Recruit Mira",
          "next": "beacon:recruit"
        },
        {
          "label": "Later",
          "next": "beacon:end"
        }
      ],
      "cancel": "beacon:end"
    },
    {
      "id": "beacon:recruit",
      "op": "recruit",
      "person": "beacon:mira",
      "next": "beacon:hired",
      "failure": "beacon:full"
    },
    {
      "id": "beacon:hired",
      "op": "flag",
      "flag": "beacon:hired",
      "value": 1,
      "next": "beacon:brief"
    },
    {
      "id": "beacon:brief",
      "op": "say",
      "portrait": "training",
      "text": "Mira joins the expedition. Walk east out of town, then follow the old survey track to the relay. Defeat its broken guardian and return here. You can save at any time with F5.",
      "next": "beacon:end"
    },
    {
      "id": "beacon:full",
      "op": "say",
      "text": "There is no free place in the expedition.",
      "next": "beacon:end"
    },
    {
      "id": "beacon:reminder",
      "op": "say",
      "portrait": "training",
      "text": "The beacon is east of Grayhaven. Mira waits for the guardian to be cleared. Come back when the relay is transmitting.",
      "next": "beacon:end"
    },
    {
      "id": "beacon:travel",
      "op": "transfer",
      "map": "beacon:wild",
      "at": [
        12,
        28
      ],
      "next": "beacon:wild-intro",
      "failure": "beacon:blocked"
    },
    {
      "id": "beacon:wild-intro",
      "op": "say",
      "text": "An old mast rises over the trees. A derelict Warden blocks its access panel. Approach the relay to engage it. Computer control is available for this demonstration.",
      "next": "beacon:end"
    },
    {
      "id": "beacon:return",
      "op": "transfer",
      "map": "beacon:town",
      "at": [
        50,
        28
      ],
      "next": "beacon:end",
      "failure": "beacon:blocked"
    },
    {
      "id": "beacon:relay-check",
      "op": "if",
      "flag": "beacon:cleared",
      "value": 1,
      "then": "beacon:relay-live",
      "else": "beacon:fight-choice"
    },
    {
      "id": "beacon:fight-choice",
      "op": "choice",
      "text": "The broken Warden turns toward your expedition. Clear the relay approach?",
      "options": [
        {
          "label": "Engage guardian",
          "next": "beacon:battle"
        },
        {
          "label": "Step away",
          "next": "beacon:end"
        }
      ],
      "cancel": "beacon:end"
    },
    {
      "id": "beacon:battle",
      "op": "battle",
      "encounter": "beacon:guardian",
      "win": "beacon:cleared",
      "loss": "beacon:defeat",
      "flee": "beacon:withdraw",
      "failure": "beacon:blocked"
    },
    {
      "id": "beacon:cleared",
      "op": "flag",
      "flag": "beacon:cleared",
      "value": 1,
      "next": "beacon:relay-live"
    },
    {
      "id": "beacon:relay-live",
      "op": "say",
      "text": "The beacon pulses across the valley. Grayhaven is back on the network. Return to the Relay Office to report your success.",
      "next": "beacon:end"
    },
    {
      "id": "beacon:withdraw",
      "op": "say",
      "text": "You withdraw. The relay remains silent; you may return and try again.",
      "next": "beacon:end"
    },
    {
      "id": "beacon:defeat",
      "op": "say",
      "text": "The guardian prevails. Restore an earlier save to try the expedition again.",
      "next": "beacon:end"
    },
    {
      "id": "beacon:reward",
      "op": "reward",
      "credits": 2500,
      "next": "beacon:paid",
      "failure": "beacon:blocked"
    },
    {
      "id": "beacon:paid",
      "op": "flag",
      "flag": "beacon:paid",
      "value": 1,
      "next": "beacon:ending"
    },
    {
      "id": "beacon:ending",
      "op": "finish",
      "portrait": "training",
      "text": "A voice crackles over the restored link. The rescue fleet has heard Grayhaven. Your expedition receives 2500 credits, and Mira smiles as the first transport crosses the evening sky. The valley has a future. Last Beacon - complete."
    },
    {
      "id": "beacon:completed",
      "op": "say",
      "text": "The rescue fleet is on its way. Your contract has already been paid.",
      "next": "beacon:end"
    },
    {
      "id": "beacon:blocked",
      "op": "say",
      "text": "The expedition cannot complete that action here. Clear space for the whole party and try again.",
      "next": "beacon:end"
    },
    {
      "id": "beacon:script-error",
      "op": "say",
      "text": "The contract script reported an error. Check the player log; no reward or party change was applied.",
      "next": "beacon:end"
    }
  ],
  "start": {
    "map": "beacon:town",
    "at": [
      24,
