{
  "type": "object",
  "properties": {
    "format": {
      "const": "btp-author-suite-v1"
    },
    "max_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "seeds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777215
            },
            "minItems": 1,
            "maxItems": 8
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "minItems": 0,
            "maxItems": 16
          }
        },
        "required": [
          "id",
          "file"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "required": [
    "format",
    "cases"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
