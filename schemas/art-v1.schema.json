{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "btp-art-v1"
    },
    "schema_version": {
      "const": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 95
          },
          "kind": {
            "enum": [
              "tile",
              "sprite",
              "icon",
              "screen"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 320
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "frame_ticks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255,
            "default": 8,
            "description": "Tile animation frame duration in 32 ms logical ticks."
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{8})+$"
              },
              "minItems": 1,
              "maxItems": 200
            },
            "minItems": 1,
            "maxItems": 256
          },
          "animations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "idle": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "directions"
                ],
                "properties": {
                  "sound": {
                    "const": 0
                  },
                  "directions": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "frame",
                          "ticks"
                        ],
                        "properties": {
                          "frame": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                          },
                          "ticks": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 255
                          }
                        }
                      }
                    },
                    "oneOf": [
                      {
                        "minItems": 1,
                        "maxItems": 1
                      },
                      {
                        "minItems": 8,
                        "maxItems": 8
                      }
                    ]
                  }
                }
              },
              "walk": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "directions"
                ],
                "properties": {
                  "sound": {
                    "const": 0
                  },
                  "directions": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "frame",
                          "ticks"
                        ],
                        "properties": {
                          "frame": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                          },
                          "ticks": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 255
                          }
                        }
                      }
                    },
                    "oneOf": [
                      {
                        "minItems": 1,
                        "maxItems": 1
                      },
                      {
                        "minItems": 8,
                        "maxItems": 8
                      }
                    ]
                  }
                }
              },
              "fire": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "directions"
                ],
                "properties": {
                  "sound": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18
                  },
                  "directions": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "frame",
                          "ticks"
                        ],
                        "properties": {
                          "frame": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                          },
                          "ticks": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 255
                          }
                        }
                      }
                    },
                    "oneOf": [
                      {
                        "minItems": 1,
                        "maxItems": 1
                      },
                      {
                        "minItems": 8,
                        "maxItems": 8
                      }
                    ]
                  }
                }
              },
              "jump": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "directions"
                ],
                "properties": {
                  "sound": {
                    "const": 0
                  },
                  "directions": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "frame",
                          "ticks"
                        ],
                        "properties": {
                          "frame": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                          },
                          "ticks": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 255
                          }
                        }
                      }
                    },
                    "oneOf": [
                      {
                        "minItems": 1,
                        "maxItems": 1
                      },
                      {
                        "minItems": 8,
                        "maxItems": 8
                      }
                    ]
                  }
                }
              },
              "damage": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "directions"
                ],
                "properties": {
                  "sound": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18
                  },
                  "directions": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "frame",
                          "ticks"
                        ],
                        "properties": {
                          "frame": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                          },
                          "ticks": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 255
                          }
                        }
                      }
                    },
                    "oneOf": [
                      {
                        "minItems": 1,
                        "maxItems": 1
                      },
                      {
                        "minItems": 8,
                        "maxItems": 8
                      }
                    ]
                  }
                }
              },
              "destruction": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "directions"
                ],
                "properties": {
                  "sound": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18
                  },
                  "directions": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "frame",
                          "ticks"
                        ],
                        "properties": {
                          "frame": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                          },
                          "ticks": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 255
                          }
                        }
                      }
                    },
                    "oneOf": [
                      {
                        "minItems": 1,
                        "maxItems": 1
                      },
                      {
                        "minItems": 8,
                        "maxItems": 8
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "frame_ticks"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "tile"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "animations"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "sprite"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tile"
                }
              }
            },
            "then": {
              "properties": {
                "width": {
                  "const": 16
                },
                "height": {
                  "const": 16
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "sprite",
                    "icon"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "width": {
                  "maximum": 64
                },
                "height": {
                  "maximum": 64
                }
              }
            }
          }
        ],
        "required": [
          "id",
          "name",
          "kind",
          "width",
          "height",
          "frames"
        ]
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slot": {
            "enum": [
              "player",
              "npc",
              "enemy",
              "locust",
              "stinger",
              "wreck"
            ]
          },
          "image": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          }
        },
        "required": [
          "slot",
          "image"
        ]
      },
      "minItems": 0,
      "maxItems": 6
    }
  },
  "required": [
    "format",
    "schema_version",
    "images",
    "bindings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BtechPort RGBA graphics library",
  "$comment": "C loader also validates exact row lengths, frame references, sequence duration <=255 ticks, unique IDs, bindings, 512 total action tracks and the 1048576 pixel budget."
}
