{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btech-port.invalid/schemas/content-v1.schema.json",
  "title": "BtechPort authored content v1",
  "description": "Runtime contract. btp-project validates cross-references, capacities and supported behavior constraints using the same C loader as both players.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "btp-content-v1"
    },
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "maxLength": 31,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "content_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31,
      "pattern": "^[ -~]+$"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "chi:legacy-v1",
            "chi:updated-lrm-v1"
          ]
        },
        "distance_scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "minimum_range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "short_range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "medium_range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "long_range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        }
      },
      "required": [
        "id"
      ]
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "broker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
            },
            "behavior": {
              "const": "chi-broker-v1"
            }
          },
          "required": [
            "id",
            "behavior"
          ]
        },
        "reload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
            },
            "behavior": {
              "const": "chi-reload-v1"
            }
          },
          "required": [
            "id",
            "behavior"
          ]
        }
      },
      "required": [
        "broker",
        "reload"
      ]
    },
    "ammunition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "price_per_shot": {
            "type": "integer",
            "minimum": 1,
            "maximum": 254
          }
        },
        "required": [
          "id",
          "price_per_shot"
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "presentations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "source": {
            "enum": [
              "chi:locust",
              "chi:red-stinger",
              "package:walker-a",
              "package:walker-b"
            ]
          }
        },
        "required": [
          "id",
          "source"
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "weapons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 95,
            "pattern": "^[ -~]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 11,
            "pattern": "^[ -~]+$"
          },
          "behavior": {
            "enum": [
              "small_laser",
              "medium_laser",
              "large_laser",
              "ppc",
              "ac2",
              "ac5",
              "ac10",
              "ac20",
              "machine_gun",
              "flamer",
              "lrm5",
              "lrm10",
              "lrm15",
              "lrm20",
              "srm2",
              "srm4",
              "srm6"
            ]
          },
          "ammunition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[ -~]+$"
          },
          "damage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "projectiles": {
            "enum": [
              1,
              2,
              4,
              5,
              6,
              10,
              15,
              20
            ]
          },
          "heat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "ranges": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "short": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "medium": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "long": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              }
            },
            "required": [
              "short",
              "medium",
              "long"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "label",
          "behavior",
          "ammunition",
          "damage",
          "projectiles",
          "heat",
          "ranges"
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "mechs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 95,
            "pattern": "^[ -~]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "pattern": "^[ -~]+$"
          },
          "mass_tons": {
            "type": "integer",
            "minimum": 20,
            "maximum": 100
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999
          },
          "presentation": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "movement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "walk": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "jump": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12
              }
            },
            "required": [
              "walk",
              "jump"
            ]
          },
          "engine_heat_sinks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "armor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left_arm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              },
              "left_torso": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              },
              "left_leg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              },
              "head": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              },
              "center_torso": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              },
              "right_arm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              },
              "right_torso": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              },
              "right_leg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              },
              "left_rear": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              },
              "center_rear": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              },
              "right_rear": {
                "type": "integer",
                "minimum": 0,
                "maximum": 83
              }
            },
            "required": [
              "left_arm",
              "left_torso",
              "left_leg",
              "head",
              "center_torso",
              "right_arm",
              "right_torso",
              "right_leg",
              "left_rear",
              "center_rear",
              "right_rear"
            ]
          },
          "structure": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left_arm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "left_torso": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "left_leg": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "head": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "center_torso": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "right_arm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "right_torso": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "right_leg": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              }
            },
            "required": [
              "left_arm",
              "left_torso",
              "left_leg",
              "head",
              "center_torso",
              "right_arm",
              "right_torso",
              "right_leg"
            ]
          },
          "actuators": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left_arm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "right_arm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "left_leg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "right_leg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              }
            },
            "required": [
              "left_arm",
              "right_arm",
              "left_leg",
              "right_leg"
            ]
          },
          "external_heat_sinks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left_arm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "left_torso": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "left_leg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "head": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "center_torso": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "right_arm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "right_torso": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "right_leg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            },
            "required": [
              "left_arm",
              "left_torso",
              "left_leg",
              "head",
              "center_torso",
              "right_arm",
              "right_torso",
              "right_leg"
            ]
          },
          "loadout": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "weapon": {
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
                },
                "location": {
                  "enum": [
                    "left_arm",
                    "left_torso",
                    "left_leg",
                    "head",
                    "center_torso",
                    "right_arm",
                    "right_torso",
                    "right_leg"
                  ]
                },
                "ammunition": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 254
                }
              },
              "required": [
                "weapon",
                "location",
                "ammunition"
              ]
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "name",
          "label",
          "mass_tons",
          "price",
          "presentation",
          "movement",
          "engine_heat_sinks",
          "armor",
          "structure",
          "actuators",
          "external_heat_sinks",
          "loadout"
        ]
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "required": [
    "format",
    "schema_version",
    "package_id",
    "content_version",
    "rules",
    "services",
    "ammunition",
    "presentations",
    "weapons",
    "mechs"
  ]
