          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 95,
            "pattern": "^[ -~]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "pattern": "^[ -~]+$"
          },
          "mass_tons": {
            "type": "integer",
            "minimum": 5,
            "maximum": 100
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999
          },
          "presentation": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "movement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "walk": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "jump": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12
              },
              "type": {
                "enum": [
                  "tracked",
                  "wheeled",
                  "hover"
                ]
              }
            },
            "required": [
              "walk",
              "jump"
            ]
          },
          "engine_heat_sinks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "armor": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "left_arm": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  },
                  "left_torso": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  },
                  "left_leg": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  },
                  "head": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  },
                  "center_torso": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  },
                  "right_arm": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  },
                  "right_torso": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  },
                  "right_leg": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  },
                  "left_rear": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  },
                  "center_rear": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  },
                  "right_rear": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 83
                  }
                },
                "required": [
                  "left_arm",
                  "left_torso",
                  "left_leg",
                  "head",
                  "center_torso",
                  "right_arm",
                  "right_torso",
                  "right_leg",
                  "left_rear",
                  "center_rear",
                  "right_rear"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "front": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "left": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "right": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "rear": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "turret": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "required": [
                  "front",
                  "left",
                  "right",
                  "rear",
                  "turret"
                ]
              }
            ]
          },
          "structure": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "left_arm": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40
                  },
                  "left_torso": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40
                  },
                  "left_leg": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40
                  },
                  "head": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40
                  },
                  "center_torso": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40
                  },
                  "right_arm": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40
                  },
                  "right_torso": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40
                  },
                  "right_leg": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40
                  }
                },
                "required": [
                  "left_arm",
                  "left_torso",
                  "left_leg",
                  "head",
                  "center_torso",
                  "right_arm",
                  "right_torso",
                  "right_leg"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "front": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "left": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "right": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "rear": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "turret": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "front",
                  "left",
                  "right",
                  "rear",
                  "turret"
                ]
              }
            ]
          },
          "actuators": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left_arm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "right_arm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "left_leg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "right_leg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              }
            },
            "required": [
              "left_arm",
              "right_arm",
              "left_leg",
              "right_leg"
            ]
          },
          "external_heat_sinks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left_arm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "left_torso": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "left_leg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "head": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "center_torso": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "right_arm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "right_torso": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "right_leg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            },
            "required": [
              "left_arm",
              "left_torso",
              "left_leg",
              "head",
              "center_torso",
              "right_arm",
              "right_torso",
              "right_leg"
            ]
          },
          "loadout": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "weapon": {
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
                },
                "location": {
                  "enum": [
                    "left_arm",
                    "left_torso",
                    "left_leg",
                    "head",
                    "center_torso",
                    "right_arm",
                    "right_torso",
                    "right_leg",
                    "front",
                    "left",
                    "right",
                    "rear",
                    "turret"
                  ]
                },
                "ammunition": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 254
                }
              },
              "required": [
                "weapon",
                "location",
                "ammunition"
              ]
            },
            "minItems": 1,
            "maxItems": 10
          },
          "kind": {
            "enum": [
              "mech",
              "vehicle"
            ]
          },
          "equipment": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "definition": {
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
                },
                "location": {
                  "enum": [
                    "left_arm",
                    "left_torso",
                    "left_leg",
                    "head",
                    "center_torso",
                    "right_arm",
                    "right_torso",
                    "right_leg"
                  ]
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                }
              },
              "required": [
                "definition",
                "location",
                "quantity"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "label",
          "mass_tons",
          "price",
          "presentation",
          "movement",
          "engine_heat_sinks",
          "armor",
          "structure",
          "loadout"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "vehicle"
                }
              }
            },
            "then": {
              "properties": {
                "movement": {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "jump": {
                      "const": 0
                    }
                  }
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "external_heat_sinks"
                    ]
                  },
                  {
                    "required": [
                      "actuators"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "external_heat_sinks",
                "actuators"
              ],
              "properties": {
                "mass_tons": {
                  "minimum": 20
                }
              }
            }
          }
        ]
