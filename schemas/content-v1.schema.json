      "minItems": 1,
      "maxItems": 256
    },
    "equipment": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 95,
            "pattern": "^[ -~]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 11,
            "pattern": "^[ -~]+$"
          },
          "behavior": {
            "enum": [
              "heat_sink",
              "jump_jet"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "label",
          "behavior"
        ]
      }
    }
  },
  "required": [
    "format",
    "schema_version",
    "package_id",
    "content_version",
    "rules",
    "services",
    "ammunition",
    "presentations",
    "weapons",
    "mechs"
  ]
}
