{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btech-port.invalid/schemas/content-v1.schema.json",
  "title": "BtechPort authored content v1",
  "description": "Runtime contract. btp-project validates cross-references, capacities and supported behavior constraints using the same C loader as both players.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "btp-content-v1"
    },
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "maxLength": 31,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "content_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31,
      "pattern": "^[ -~]+$"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "chi:legacy-v1",
            "chi:updated-lrm-v1"
          ]
        },
        "distance_scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "minimum_range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "short_range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "medium_range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "long_range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        }
      },
      "required": [
        "id"
      ]
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "broker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
            },
            "behavior": {
              "const": "chi-broker-v1"
            }
          },
          "required": [
            "id",
            "behavior"
          ]
        },
        "reload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
            },
            "behavior": {
              "const": "chi-reload-v1"
            }
          },
          "required": [
            "id",
            "behavior"
          ]
        }
      },
      "required": [
        "broker",
        "reload"
      ]
    },
    "ammunition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "price_per_shot": {
            "type": "integer",
            "minimum": 1,
            "maximum": 254
          }
        },
        "required": [
          "id",
          "price_per_shot"
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "presentations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "source": {
            "enum": [
              "chi:locust",
              "chi:red-stinger",
              "package:walker-a",
              "package:walker-b",
              "package:art"
            ]
          },
          "image": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          }
        },
        "required": [
          "id",
          "source"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "package:art"
                }
              }
            },
            "then": {
              "required": [
                "image"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "image"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "weapons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 95,
            "pattern": "^[ -~]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 11,
            "pattern": "^[ -~]+$"
          },
          "behavior": {
            "enum": [
              "small_laser",
              "medium_laser",
              "large_laser",
              "ppc",
              "ac2",
              "ac5",
              "ac10",
              "ac20",
              "machine_gun",
              "flamer",
              "lrm5",
              "lrm10",
              "lrm15",
              "lrm20",
              "srm2",
              "srm4",
              "srm6"
            ]
          },
          "ammunition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[ -~]+$"
          },
          "damage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "projectiles": {
            "enum": [
              1,
              2,
              4,
              5,
              6,
              10,
              15,
              20
            ]
          },
          "heat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "ranges": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "short": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "medium": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "long": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              }
            },
            "required": [
              "short",
              "medium",
              "long"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "label",
          "behavior",
          "ammunition",
          "damage",
          "projectiles",
          "heat",
          "ranges"
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "mechs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
