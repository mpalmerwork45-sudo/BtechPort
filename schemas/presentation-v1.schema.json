{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BtechPort independent pixels, font, sound and tactical adapter v1",
  "$comment": "The C loader also checks references, total sound duration and collection bounds. Formation values are offsets plus eight.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "btp-presentation-v1"
    },
    "schema_version": {
      "const": 1
    },
    "palette": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{6}$"
      }
    },
    "font": {
      "type": "array",
      "minItems": 96,
      "maxItems": 96,
      "items": {
        "type": "string",
        "pattern": "^(0[0-9a-f]|1[0-9a-f]){7}$"
      }
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "array",
        "minItems": 16,
        "maxItems": 16,
        "items": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16,
          "pattern": "^[0-9a-f]+$"
        }
      }
    },
    "sprites": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[0-9a-f]+$"
          }
        }
      }
    },
    "portraits": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 64,
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]+$"
        }
      }
    },
    "hit_locations": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7
      }
    },
    "people_formation": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "mech_formation": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "personal_weapon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11
        },
        "damage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "range": {
          "type": "integer",
          "minimum": 3,
          "maximum": 31
        }
      },
      "required": [
        "label",
        "damage",
        "range"
      ]
    },
    "sounds": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hz": {
              "type": "integer",
              "minimum": 50,
              "maximum": 4000
            },
            "ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400
            }
          },
          "required": [
            "hz",
            "ms"
          ]
        }
      }
    }
  },
  "required": [
    "format",
    "schema_version",
    "palette",
    "font",
    "tiles",
    "sprites",
    "portraits",
    "hit_locations",
    "people_formation",
    "mech_formation",
    "personal_weapon",
    "sounds"
  ]
}
