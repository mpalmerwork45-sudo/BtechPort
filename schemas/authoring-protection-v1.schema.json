{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "kind": {
      "enum": [
        "object",
        "fields",
        "map_region",
        "world_region"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1,
      "maxItems": 32
    },
    "map": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
    },
    "world": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
    },
    "rect": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1024
      },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "required": [
    "id",
    "label",
    "kind"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
