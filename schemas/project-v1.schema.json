{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BtechPort directory project v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "btp-project-v1"
    },
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "maxLength": 31,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "content_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31,
      "pattern": "^[ -~]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 95,
      "pattern": "^[ -~]+$"
    },
    "requires": {
      "enum": [
        "chi-original-dos-1.03",
        "none",
        "chi-local-dos-1.03"
      ]
    },
    "startup": {
      "enum": [
        "chi-training-v1",
        "authored-adventure-v1",
        "chi-import-v1"
      ]
    },
    "rules_profile": {
      "enum": [
        "chi:legacy-v1",
        "chi:updated-lrm-v1"
      ]
    },
    "save_policy": {
      "const": "strict-content-v1"
    },
    "definitions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1023,
      "pattern": "^[ -~]+$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "slot": {
            "enum": [
              "broker",
              "training",
              "lounge",
              "prison",
              "inventor",
              "cinema",
              "hospital",
              "comstar",
              "clothes",
              "video-hut",
              "mayor"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1023,
            "pattern": "^[ -~]+$"
          }
        },
        "required": [
          "id",
          "slot",
          "file"
        ]
      },
      "minItems": 0,
      "maxItems": 11
    },
    "adventure": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1023
    },
    "presentation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1023,
      "pattern": "^[ -~]+$"
    },
    "scripts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1023,
            "pattern": "^[ -~]+$"
          }
        },
        "required": [
          "id",
          "file"
        ]
      }
    },
    "graphics": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1023
    },
    "campaign": {
      "const": "campaign.json"
    },
    "chi_spatial": {
      "const": "chi-spatial.json"
    },
    "chi_presentation": {
      "const": "chi-presentation.json"
    },
    "chi_scripts": {
      "const": "chi-scripts.json"
    },
    "chi_services": {
      "const": "chi-services.json"
    },
    "chi_missions": {
      "const": "chi-missions.json"
