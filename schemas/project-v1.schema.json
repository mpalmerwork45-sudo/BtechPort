  "required": [
    "format",
    "schema_version",
    "package_id",
    "content_version",
    "title",
    "requires",
    "startup",
    "rules_profile",
    "save_policy",
    "definitions",
    "assets"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "startup": {
            "const": "authored-adventure-v1"
          }
        }
      },
      "then": {
        "required": [
          "adventure"
        ]
      },
      "else": {
        "not": {
          "required": [
            "adventure"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "requires": {
            "const": "none"
          }
        }
      },
      "then": {
        "required": [
          "presentation",
          "adventure"
        ],
        "properties": {
          "startup": {
            "const": "authored-adventure-v1"
          },
          "assets": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "presentation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "requires": {
            "const": "chi-local-dos-1.03"
          }
        }
      },
      "then": {
        "required": [
          "campaign",
          "resources"
        ],
        "properties": {
          "startup": {
            "const": "chi-import-v1"
          }
        }
      },
      "else": {
        "properties": {
          "campaign": false,
          "chi_spatial": false,
          "chi_presentation": false,
          "chi_scripts": false,
          "chi_services": false,
          "chi_missions": false,
          "resources": false,
          "startup": {
            "not": {
              "const": "chi-import-v1"
            }
          }
        }
      }
    }
  ],
  "dependentRequired": {
    "chi_bridge": [
      "chi_events",
      "chi_spatial",
      "chi_scripts"
    ],
    "chi_events": [
      "chi_bridge"
    ]
  }
